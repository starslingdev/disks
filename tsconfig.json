{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Inlined from @tsconfig/node24 + @tsconfig/strictest (removed as dependencies; a simple
  // action carries its compiler flags in one file instead of two preset packages).
  "compilerOptions": {
    "lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Error", "ESNext.Iterator", "ESNext.Promise"],
    "module": "nodenext",
    "target": "es2024",
    "types": ["node"],
    "moduleResolution": "node16",
    "strict": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    // ProcessEnv is an index signature; dot access is the codebase style (Biome useLiteralKeys).
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["scripts", "src", "tests", "tsdown.config.ts", ".github/bench"]
}
